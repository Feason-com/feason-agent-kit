{
  "name": "@feason/agent-kit",
  "version": "0.1.0",
  "description": "Open-source profiles and helpers for building source-grounded Christian learning agents.",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./gospels/*": {
      "types": "./dist/gospels/*.d.ts",
      "import": "./dist/gospels/*.js"
    },
    "./angelent": {
      "types": "./dist/angelent.d.ts",
      "import": "./dist/angelent.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "check": "npm run build && npm test"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Feason-com/feason-agent-kit.git"
  },
  "homepage": "https://www.feason.com/mcp",
  "bugs": {
    "url": "https://github.com/Feason-com/feason-agent-kit/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "typescript": "^6.0.2",
    "vitest": "^4.1.12"
  }
}
